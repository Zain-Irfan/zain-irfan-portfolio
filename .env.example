# Copy to .env.local and fill in. Get a free API key at https://resend.com
RESEND_API_KEY=
# Where contact form messages are delivered
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend
CONTACT_FROM_EMAIL=
# Optional: your live site URL, e.g. https://zainirfan.dev (used for link previews)
NEXT_PUBLIC_SITE_URL=
